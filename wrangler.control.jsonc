{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "angelmcp-control-demo",
  "account_id": "6334e1f9af90be70f091a0116425606a",
  "main": "src/workers/control.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  // Secrets: MANAGEMENT_API_TOKEN, CONTROL_RESPONSE_KEK, CONTROL_GATEWAY_TOKEN,
  // CONTROL_BROKER_TOKEN, DEMO_ADMIN_TOKEN
  // No ACCOUNT_ID: the Account now arrives from the session, so naming one here
  // is what made this Worker serve a single tenant. No ACCESS_* either — the
  // Cloudflare Access application in front of this Worker is gone, and the
  // sign-in Worker holds the door instead.
  "vars": {
    "CONTROL_BASE_URL": "https://dash.angelmcp.ai",
    "GATEWAY_BASE_URL": "https://angelmcp-gateway-demo.sam-633.workers.dev",
    // Where the dashboard sends somebody who is not signed in. Same zone as
    // this host, which is what lets the session cookie reach both.
    "AUTH_BASE_URL": "https://auth.angelmcp.ai"
  },
  "routes": [{ "pattern": "dash.angelmcp.ai", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "AccountRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AccountRegistry"] }
  ],
  "services": [
    { "binding": "GATEWAY", "service": "angelmcp-gateway-demo" },
    { "binding": "BROKER", "service": "angelmcp-broker-demo" },
    // Control asks this Worker who is calling, forwarding the caller's own
    // credential. It never reads the session tables itself.
    { "binding": "AUTH", "service": "angelmcp-auth" }
  ],
  "assets": {
    "directory": "./www",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

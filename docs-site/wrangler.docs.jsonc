{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "angelmcp-docs-demo",
  "account_id": "6334e1f9af90be70f091a0116425606a",
  "compatibility_date": "2026-07-18",
  // Assets-only worker: no `main`, no service bindings, no Cloudflare Access.
  // The docs are public by design — the opposite of the Access-gated Control
  // dashboard. Deploy from a built `./dist` (see build.sh); never point this at
  // the repo `docs/` directly, because the SPA and llms.txt/SKILL.md live
  // alongside the rendered markdown.
  // not_found_handling stays the default ("none"): a missing path answers 404.
  // The viewer routes with URL fragments only, so every real page load hits
  // "/"; an SPA fallback would instead answer 200 text/html for any typo'd
  // .md/.txt URL, which misleads the agents this site exists for.
  "assets": {
    "directory": "./dist"
  },
  // The canonical docs host. build.sh already writes this URL into llms.txt and
  // SKILL.md, so deploy from a plain `./build.sh` — the DOCS_BASE_URL rewrite
  // exists only for the interim workers.dev host. Needs the `angelmcp.ai` zone
  // active in this account first (docs/domain-architecture.md, step 1). The apex
  // `/docs` + `/llms.txt` redirects still wait on the apex dispatcher.
  "routes": [
    { "pattern": "docs.angelmcp.ai", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

{
  "name": "@smcllns/angel-core",
  "version": "0.3.0",
  "description": "Portable Angel policy compiler, artifact contract, and target-neutral CLI",
  "type": "module",
  "types": "src/index.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./build": {
      "types": "./src/build.ts",
      "default": "./src/build.ts"
    },
    "./cli": {
      "types": "./src/cli/index.ts",
      "default": "./src/cli/index.ts"
    }
  },
  "bin": {
    "angel": "src/scripts/angel.ts"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/exocognito/angelmcp.git",
    "directory": "packages/core"
  },
  "scripts": {
    "angel": "bun run src/scripts/angel.ts",
    "build": "bun run angel build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm test",
    "generate:adapters": "bun run src/scripts/generate-adapters.ts"
  },
  "dependencies": {
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@types/bun": "^1.1.3",
    "typescript": "^5.4.5"
  }
}

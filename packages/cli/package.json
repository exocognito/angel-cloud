{
  "name": "@angelmcp/cli",
  "version": "0.1.0",
  "description": "The Angel CLI: write, build, publish, and deploy an inspectable agent toolbox",
  "type": "module",
  "license": "MIT",
  "bin": {
    "angel": "dist/angel.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/exocognito/angelmcp.git",
    "directory": "packages/cli"
  },
  "homepage": "https://angelmcp.ai",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run build"
  },
  "devDependencies": {
    "@smcllns/angel-core": "workspace:*",
    "@types/bun": "^1.1.3",
    "typescript": "^5.4.5"
  }
}
